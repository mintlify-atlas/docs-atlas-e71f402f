  "keyFeatures": [
    "Interactive calendar for medical appointments and health events",
    "Weight tracking with historical graphs and trends",
    "Blood pressure and heart rate monitoring",
    "Exercise activity logging",
    "Medical history and document storage",
    "Secure data sharing with read-only access",
    "PDF export of health records",
    "Multi-user support with role-based permissions",
    "First-user-admin auto-installation",
    "Docker support for containerized deployment"
  ],
  "publicApiSurface": [
    "User Model (authentication, roles, permissions, data sharing)",
    "MedicalAppointment Model (appointments tracking)",
    "MeasurementWeight Model (weight measurements)",
    "MeasurementHeart Model (heart rate and blood pressure)",
    "ActivityExercise Model (exercise tracking)",
    "Calendar Livewire Component (dashboard calendar view)",
    "WeightLog Livewire Component (weight entry form)",
    "HeartLog Livewire Component (blood pressure entry form)",
    "AppointmentLog Livewire Component (appointment entry form)",
    "ActivityLog Livewire Component (exercise entry form)",
    "ShareData Livewire Component (data sharing management)",
    "HealthHistory Livewire Component (historical records view)",
    "HealthStats Livewire Component (statistics and graphs)",
    "UserManagement Livewire Component (admin panel)",
    "ExportController (PDF export functionality)",
    "AttachmentController (file viewing)",
    "FileController (file handling)"
  ]
